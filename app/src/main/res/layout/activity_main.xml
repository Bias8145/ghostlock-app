        <com.google.android.material.button.MaterialButton android:id="@+id/navHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="18dp" app:iconGravity="textTop" app:iconSize="28dp" app:iconPadding="0dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/navSettings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="18dp" app:iconGravity="textTop" app:iconSize="28dp" app:iconPadding="0dp"/>
    </LinearLayout>
</LinearLayout>