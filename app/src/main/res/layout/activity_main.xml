                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical"><com.ghostlock.app.SettingsButton android:id="@+id/advancedButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_advanced" android:padding="11dp" android:src="@drawable/ic_advanced" android:tint="@color/icon_tint"/><com.ghostlock.app.ThemeToggleButton android:id="@+id/themeToggleButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="2dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_theme_toggle" android:padding="10dp"/></LinearLayout>
