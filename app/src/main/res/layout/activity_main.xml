/parseButton" android:tag="parse_boot" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="Parse Boot" android:textAllCaps="false" app:cornerRadius="18dp"/></LinearLayout><com.ghostlock.app.ThemedToolButton android:id="@+id/exportButton" android:tag="export" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/action_export_offsets" android:textAllCaps="false" android:visibility="gone" app:cornerRadius="18dp"/></com.ghostlock.app.CollapsibleToolsLayout><com.ghostlock.app.ConfirmRunButton android:id="@+id/runButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="0.8" android:background="@drawable/bg_tool_header" android:elevation="0dp" android:gravity="center" android:minHeight="56dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="▶  Run" android:textAllCaps="false" android:textColor="@color/run_text" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="520dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/log_bg" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/log_title" android:textColor="@color/log_title" android:textSize="14sp" android:textStyle="bold"/><com.google.android.material.button.MaterialButton android:id="@+id/copyButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="132dp" android:layout_height="44dp" android:minWidth="0dp" android:text="Copy log" android:textAllCaps="false" android:textColor="@color/log_title" android:textSize="12sp" android:visibility="visible" android:contentDescription="Copy log" app:backgroundTint="@color/surface_container" app:cornerRadius="14dp" app:strokeWidth="0dp"/></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="10dp" android:background="@color/log_divider"/><com.ghostlock.app.LogScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:fadeScrollbars="false" android:overScrollMode="always" android:paddingBottom="16dp" android:scrollbars="vertical" android:clipToPadding="false"><TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:textColor="@color/log_text" android:textIsSelectable="true" android:textSize="12sp"/></com.ghostlock.app.LogScrollView></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
