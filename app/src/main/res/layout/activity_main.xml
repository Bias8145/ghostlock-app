                        <LinearLayout android:id="@+id/kernelChip" android:layout_width="wrap_content" android:layout_height="26dp" android:layout_marginStart="7dp" android:background="@drawable/bg_kernel_status" android:gravity="center_vertical" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"><TextView android:id="@+id/kernelChipText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/kernel_supported" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
