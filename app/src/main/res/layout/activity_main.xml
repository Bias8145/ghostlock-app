<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout android:id="@+id/advancedPanel" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Spinner android:id="@+id/cpuSpinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="-20dp" android:layout_marginEnd="-20dp"
        android:clipToPadding="false" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="16dp" android:paddingBottom="0dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                        <LinearLayout android:id="@+id/kernelChip" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginStart="7dp" android:background="@drawable/bg_kernel_status" android:gravity="center_vertical" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp">
                            <TextView android:id="@+id/kernelChipText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/kernel_supported" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/header_subtitle" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <com.ghostlock.app.SettingsButton android:id="@+id/advancedButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_advanced" android:padding="11dp" android:src="@drawable/ic_advanced" android:tint="@color/icon_tint" />
                    <com.ghostlock.app.ThemeToggleButton android:id="@+id/themeToggleButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="2dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_theme_toggle" android:padding="10dp" />
                </LinearLayout>
            </LinearLayout>

            <com.ghostlock.app.RuntimeStatusView android:id="@+id/runtimeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_container_low" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.ghostlock.app.DeviceInfoHeader
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:layout_marginBottom="8dp" />
                    <com.ghostlock.app.KernelInfoView
                        android:id="@+id/deviceInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:maxLines="2" android:textColor="@color/text_primary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                <com.ghostlock.app.CollapsibleToolsLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.7" android:layout_marginEnd="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_tool_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="6dp">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_tools" android:tint="@color/icon_tint" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Tools" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
                            <com.ghostlock.app.ThemedToolButton android:id="@+id/importButton" android:tag="import" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Import" android:textAllCaps="false" app:cornerRadius="18dp" />
                            <com.ghostlock.app.ThemedToolButton android:id="@+id/otaButton" android:tag="parse_link" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Parse Link" android:textAllCaps="false" app:cornerRadius="18dp" />
                        </LinearLayout>
                        <com.ghostlock.app.ThemedToolButton android:id="@+id/parseButton" android:tag="parse_boot" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="Parse Boot" android:textAllCaps="false" app:cornerRadius="18dp" />
                    </LinearLayout>
                    <com.ghostlock.app.ThemedToolButton android:id="@+id/exportButton" android:tag="export" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/action_export_offsets" android:textAllCaps="false" android:visibility="gone" app:cornerRadius="18dp" />
                </com.ghostlock.app.CollapsibleToolsLayout>
                <com.ghostlock.app.ConfirmRunButton android:id="@+id/runButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="0.8" android:background="@drawable/bg_tool_header" android:elevation="0dp" android:gravity="center" android:minHeight="56dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="▶  Run" android:textAllCaps="false" android:textColor="@color/run_text" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <com.ghostlock.app.InstallationProgressView android:id="@+id/installationProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/logPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="8dp" android:minHeight="0dp" app:cardBackgroundColor="@color/log_bg" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/log_title" android:textColor="@color/log_title" android:textSize="14sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/copyButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="100dp" android:layout_height="40dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:gravity="center" android:text="Copy log" android:textAllCaps="false" android:textColor="@color/log_title" android:textSize="12sp" android:contentDescription="Copy log" app:backgroundTint="@color/surface_container" app:cornerRadius="13dp" app:strokeWidth="0dp" />
                        <com.ghostlock.app.ClearLogButton android:id="@+id/clearLogButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="100dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:gravity="center" android:text="Clear log" android:textAllCaps="false" android:textColor="@color/log_title" android:textSize="12sp" android:contentDescription="Clear log" app:backgroundTint="@color/surface_container" app:cornerRadius="13dp" app:strokeWidth="0dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="12dp" android:background="@color/log_divider" />
                    <com.ghostlock.app.LogScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:fadeScrollbars="false" android:overScrollMode="always" android:paddingBottom="10dp" android:scrollbars="vertical" android:clipToPadding="false">
                        <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:textColor="@color/log_text" android:textIsSelectable="true" android:textSize="12sp" />
                    </com.ghostlock.app.LogScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
