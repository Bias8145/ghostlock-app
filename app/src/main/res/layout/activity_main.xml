<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:clipToPadding="false" android:fillViewport="true"
    android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:gravity="center_vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/app_name" android:scaleType="fitCenter" android:src="@drawable/ic_launcher_foreground" android:tint="@color/icon_tint"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/header_subtitle" android:textColor="@color/text_secondary" android:textSize="11sp"/>
            </LinearLayout>
            <ImageButton android:id="@+id/advancedButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_advanced" android:padding="11dp" android:src="@drawable/ic_advanced" android:tint="@color/icon_tint"/>
        </LinearLayout>

        <com.ghostlock.app.RuntimeStatusView android:id="@+id/runtimeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

        <!-- Legacy status bindings are retained as a zero-size compatibility shim. -->
        <LinearLayout android:id="@+id/kernelChip" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <TextView android:id="@+id/kernelChipText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/surface_container_low" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE INFO" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                <com.ghostlock.app.KernelInfoView android:id="@+id/deviceInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="12sp"/>
                <com.ghostlock.app.KsuStatusView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@android:color/transparent" android:paddingStart="0dp" android:paddingEnd="0dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/advancedPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/surface_container_low" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SETTINGS &amp; ADVANCED" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:background="@drawable/bg_spinner" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/cpu_pair_label" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                        <Spinner android:id="@+id/cpuSpinner" android:layout_width="150dp" android:layout_height="match_parent" android:background="@android:color/transparent"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:orientation="horizontal">
                        <com.ghostlock.app.SocialLinkButton android:id="@+id/telegramButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Telegram" android:textAllCaps="false" app:icon="@drawable/ic_telegram" app:iconGravity="textStart" app:iconPadding="6dp"/>
                        <com.ghostlock.app.SocialLinkButton android:id="@+id/githubButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="18dp" android:text="GitHub" android:textAllCaps="false" app:icon="@drawable/ic_github" app:iconGravity="textStart" app:iconPadding="6dp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/exportButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="@string/action_export_offsets" android:textAllCaps="false" android:visibility="gone" app:cornerRadius="14dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="520dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/log_bg" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/log_title" android:textColor="@color/log_title" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Live execution output" android:textColor="@color/log_secondary" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/logStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="READY" android:textColor="@color/log_secondary" android:textSize="10sp" android:textStyle="bold"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/copyButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Copy log" android:textAllCaps="false" android:textColor="@color/log_title" android:textSize="12sp" app:cornerRadius="12dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:background="@color/log_divider"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false">
                    <com.ghostlock.app.LogScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:fadeScrollbars="false" android:overScrollMode="always" android:paddingBottom="94dp" android:scrollbars="vertical" android:clipToPadding="false" android:descendantFocusability="beforeDescendants">
                        <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:textColor="@color/log_text" android:textIsSelectable="true" android:textSize="12sp"/>
                    </com.ghostlock.app.LogScrollView>
                    <com.ghostlock.app.ConfirmRunButton android:id="@+id/runButton" style="@style/Widget.Material3.Button" android:layout_width="148dp" android:layout_height="62dp" android:layout_gravity="end|bottom" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:elevation="12dp" android:text="Run" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" app:cornerRadius="22dp"/>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.ghostlock.app.CollapsibleToolsLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_tool_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_tools" android:tint="@color/icon_tint"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tools" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Utilities &amp; advanced actions" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:baselineAligned="false" android:orientation="horizontal">
                <com.ghostlock.app.ThemedToolButton android:id="@+id/importButton" android:tag="import" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:minWidth="0dp" android:text="Import" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="16dp"/>
                <com.ghostlock.app.ThemedToolButton android:id="@+id/otaButton" android:tag="parse_link" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:minWidth="0dp" android:text="Parse Link" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="16dp"/>
                <com.ghostlock.app.ThemedToolButton android:id="@+id/parseButton" android:tag="parse_boot" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:minWidth="0dp" android:text="Parse Boot" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="16dp"/>
            </LinearLayout>
        </com.ghostlock.app.CollapsibleToolsLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>