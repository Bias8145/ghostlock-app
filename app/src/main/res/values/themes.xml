<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GhostLock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_navigation_bar</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.GhostLock.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GhostLock.MaterialAlertDialog</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
    </style>

    <style name="ThemeOverlay.GhostLock.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOutline">@color/outline_variant</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GhostLock.Dialog</item>
    </style>

    <style name="ShapeAppearance.GhostLock.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
