<resources>
    <style name="Theme.GhostLock" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:spinnerDropDownItemStyle">@style/Widget.GhostLock.SpinnerDropDownItem</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_low</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GhostLock.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.GhostLock.AlertDialog</item>
    </style>

    <style name="Theme.GhostLock.Settings" parent="Theme.GhostLock">
        <item name="android:windowAnimationStyle">@style/Animation.GhostLock.Settings</item>
    </style>

    <style name="Animation.GhostLock.Settings" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@anim/settings_enter</item>
        <item name="android:windowExitAnimation">@anim/settings_exit</item>
        <item name="android:windowShowAnimation">@anim/settings_enter</item>
        <item name="android:windowHideAnimation">@anim/settings_exit</item>
    </style>

    <style name="Widget.GhostLock" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:elevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.GhostLock.SpinnerDropDownItem">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ThemeOverlay.GhostLock.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorOutline">@color/border</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GhostLock.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.GhostLock.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.GhostLock.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.GhostLock.DialogButton</item>
        <item name="android:windowBackground">@drawable/bg_ghostlock_dialog</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>

    <style name="ShapeAppearance.GhostLock.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.GhostLock.DialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
